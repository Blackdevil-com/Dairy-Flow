# DairyFlow Environment Variables
PROJECT_NAME="DairyFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# For local development with SQLite (aiosqlite):
DATABASE_URL="sqlite+aiosqlite:///./dairyflow.db"

# For PostgreSQL on local machine or AWS EC2:
# DATABASE_URL="postgresql+asyncpg://dairyflow_user:secure_password@localhost:5432/dairyflow_db"

# JWT Security
SECRET_KEY="dairyflow-change-in-production-super-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# Business & GST Configuration
BUSINESS_NAME="DairyFlow Co-operative & Milk Processing"
TRADE_NAME="DairyFlow Depot"
STATE_CODE="27"
STATE_NAME="Maharashtra"
GST_STATUS="UNVERIFIED_DEMO"
GSTIN=""
DEFAULT_DOCUMENT_TYPE="COMMERCIAL_RECEIPT"
DEMO_WATERMARK_ENABLED=True
DEFAULT_MIN_STOCK_ALERT=20.0
